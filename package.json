{
  "name": "orderingx-website-marketplace",
  "version": "1.2.0",
  "description": "This repository is a template marketplace using functional components.",
  "main": "index.js",
  "private": true,
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "serve": "vite preview --port 3000",
    "prod": "pnpm build && pnpm preview",
    "test": "NODE_OPTIONS='--max-old-space-size=4096' vitest --run --pool=forks --maxWorkers=1",
    "test:watch": "vitest",
    "test:coverage": "NODE_OPTIONS='--max-old-space-size=4096' vitest --coverage --run --pool=forks --maxWorkers=1",
    "test:coverage:summary": "node scripts/coverage-summary.js",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "i18n:generate": "node i18n/generate.cjs",
    "i18n:check-generated": "node i18n/check-generated.cjs",
    "i18n:verify": "node i18n/verify.cjs",
    "i18n:missing": "node i18n/missing.cjs",
    "i18n:apply-batch": "node i18n/applyBatch.cjs",
    "i18n:sync": "node i18n/sync.cjs --dry-run",
    "i18n:sync:live": "node i18n/sync.cjs --live",
    "i18n:demo-e2e": "node i18n/demo-local-e2e.cjs",
    "prepare": "husky",
    "deploy:production": "wrangler deploy --env production",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:development": "wrangler deploy --env=\"\"",
    "cf:dev": "wrangler dev",
    "cf:build": "git submodule update --init --recursive && pnpm install --frozen-lockfile && pnpm build",
    "marketplace:test": "node --test tests/marketplace/*.test.mjs",
    "marketplace:start": "node scripts/marketplace/cli.mjs start",
    "marketplace:restore": "node scripts/marketplace/cli.mjs restore",
    "marketplace:doctor": "node scripts/marketplace/cli.mjs doctor",
    "marketplace:configure": "node scripts/marketplace/cli.mjs configure",
    "marketplace:connection": "node scripts/marketplace/cli.mjs connection"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ordering-co/website-marketplace-v26.git"
  },
  "author": "Ordering",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Ordering-co/website-marketplace-v26/issues"
  },
  "dependencies": {
    "@loadable/component": "^5.15.2",
    "@popperjs/core": "^2.5.3",
    "@segment/analytics-next": "^1.35.1",
    "@sentry/react": "^7.109.0",
    "@stripe/react-stripe-js": "^1.1.2",
    "@stripe/stripe-js": "^1.9.0",
    "date-fns": "^2.30.0",
    "dayjs": "^1.9.3",
    "decimal.js": "^10.4.3",
    "firebase": "9.15.0",
    "html-react-parser": "^3.0.15",
    "intersection-observer": "^0.12.2",
    "libphonenumber-js": "^1.9.17",
    "moment": "^2.29.4",
    "nanoid": "^5.0.7",
    "payment": "^2.4.6",
    "polished": "^3.6.6",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-calendar": "^3.3.1",
    "react-credit-cards-2": "^0.10.0",
    "react-date-range": "^1.4.0",
    "react-datepicker": "^4.12.0",
    "react-dom": "^18.2.0",
    "react-google-recaptcha": "latest",
    "react-google-recaptcha-v3": "^1.10.0",
    "react-helmet": "^6.1.0",
    "react-hook-form": "^6.8.1",
    "react-icons": "^5.6.0",
    "react-ios-pwa-prompt": "^1.8.4",
    "react-linkify": "^1.0.0-alpha",
    "react-loading-skeleton": "3.3.1",
    "react-otp-input": "^2.3.0",
    "react-phone-number-input": "^3.1.6",
    "react-popper": "^2.2.3",
    "react-router-dom": "^5.2.0",
    "react-select": "^4.3.1",
    "smart-app-banner": "^2.0.0",
    "smoothscroll-polyfill": "^0.4.4",
    "socket.io-client": "^4.7.2",
    "styled-components": "5.3.3",
    "swiper": "^11.0.7",
    "uuid": "^10.0.0",
    "web-vitals": "^2.1.4"
  },
  "eslintConfig": {
    "extends": [
      "standard",
      "plugin:react/recommended"
    ],
    "settings": {
      "react": {
        "version": "detect"
      }
    },
    "globals": {
      "HTMLRewriter": "readonly"
    },
    "rules": {
      "react/prop-types": "off",
      "react/react-in-jsx-scope": "off"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^3.2.4",
    "babel-plugin-styled-components": "^2.1.4",
    "eslint": "^8.0.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.25.2",
    "eslint-plugin-n": "^15.0.0 || ^16.0.0 ",
    "eslint-plugin-promise": "^6.0.0",
    "eslint-plugin-react": "^7.34.1",
    "husky": "^9.0.11",
    "jsdom": "^26.1.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.0.1",
    "vitest": "^3.2.4",
    "wrangler": "^4.84.0"
  }
}
